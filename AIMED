<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIMED OS · Joinville · 25-26 Abril 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   AIMED OS — Site-aula para o curso AIMED Joinville Abril 2026
   Identidade: navy profundo + dourado cinematográfico
   ============================================================ */

:root {
  --navy:         #050e1f;
  --navy-mid:     #0a1930;
  --navy-light:   #0f2545;
  --navy-card:    #0d1e3a;
  --navy-card-hi: #112545;
  --gold:         #c9a84c;
  --gold-light:   #e8c97a;
  --gold-pale:    #f5e6c0;
  --gold-dim:     #7a6030;
  --white:        #ffffff;
  --gray-100:     #e8edf5;
  --gray-300:     #9aaabf;
  --gray-500:     #4a5f7a;
  --teal:         #25a8bc;
  --teal-dark:    #1a7a8a;
  --purple:       #a78bfa;
  --purple-dark:  #6b46a3;
  --coral:        #f87171;
  --coral-dark:   #a33333;
  --green:        #4ade80;
  --green-dark:   #276639;
  --border:       rgba(201,168,76,0.18);
  --border-strong:rgba(201,168,76,0.45);
  --radius:       6px;
  --radius-lg:    10px;
}

* { margin:0; padding:0; box-sizing:border-box; }

html, body {
  background: var(--navy);
  color: var(--gray-100);
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  line-height: 1.65;
  min-height: 100vh;
  overflow-x: hidden;
}

body::before {
  content:'';
  position:fixed; inset:0;
  background-image:
    linear-gradient(rgba(201,168,76,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(201,168,76,0.025) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events:none;
  z-index:0;
}

button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
a { color: inherit; text-decoration: none; }
ul { list-style: none; }

/* ============================================================
   LAYOUT PRINCIPAL
   ============================================================ */

.app {
  display: grid;
  grid-template-columns: 320px 1fr;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ============================================================
   SIDEBAR — TRILHA DO CURSO
   ============================================================ */

.sidebar {
  background: var(--navy-mid);
  border-right: 1px solid var(--border);
  padding: 0;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
}

.sidebar::-webkit-scrollbar { width: 6px; }
.sidebar::-webkit-scrollbar-track { background: transparent; }
.sidebar::-webkit-scrollbar-thumb { background: rgba(201,168,76,0.25); border-radius: 3px; }

.sidebar-header {
  padding: 24px 24px 20px;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  background: var(--navy-mid);
  z-index: 10;
}

.brand {
  font-family: 'Playfair Display', serif;
  font-size: 1.5em;
  font-weight: 900;
  color: var(--white);
  letter-spacing: -0.02em;
  line-height: 1;
}
.brand em {
  color: var(--gold);
  font-style: italic;
}

.brand-sub {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--gold);
  text-transform: uppercase;
  margin-top: 8px;
}

.brand-date {
  font-size: 12px;
  color: var(--gray-300);
  margin-top: 4px;
}

/* Blocos da trilha */
.trail {
  padding: 16px 0 40px;
}

.block-group {
  margin-bottom: 8px;
}

.block-header {
  padding: 14px 24px 10px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.block-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.block-1 .block-dot { background: var(--teal); }
.block-2 .block-dot { background: var(--gold); }
.block-3 .block-dot { background: var(--purple); }
.block-4 .block-dot { background: var(--coral); }

.block-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--gold-dim);
  text-transform: uppercase;
}

.block-role {
  font-family: 'Playfair Display', serif;
  font-size: 14px;
  font-weight: 700;
  color: var(--gold);
  margin-left: auto;
}

.block-modules {
  display: flex;
  flex-direction: column;
}

.module-link {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 10px 24px 10px 44px;
  border-left: 2px solid transparent;
  font-size: 13px;
  color: var(--gray-300);
  transition: all 0.2s;
  position: relative;
}

.module-link::before {
  content: '';
  position: absolute;
  left: 30px; top: 17px;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: rgba(201,168,76,0.25);
  transition: all 0.2s;
}

.module-link:hover {
  background: rgba(201,168,76,0.04);
  color: var(--gray-100);
}
.module-link:hover::before { background: var(--gold-dim); }

.module-link.active {
  background: rgba(201,168,76,0.08);
  border-left-color: var(--gold);
  color: var(--white);
}
.module-link.active::before {
  background: var(--gold);
  box-shadow: 0 0 0 4px rgba(201,168,76,0.15);
}

.module-link.done::before {
  background: var(--gold);
  opacity: 0.4;
}

.module-link.break {
  color: var(--gray-500);
  font-style: italic;
  cursor: default;
}
.module-link.break:hover { background: transparent; color: var(--gray-500); }
.module-link.break::before { background: rgba(201,168,76,0.15); }

.m-time {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.05em;
  color: var(--gold-dim);
  flex-shrink: 0;
  padding-top: 2px;
  min-width: 62px;
}

.module-link.active .m-time { color: var(--gold); }

.m-title {
  flex: 1;
  line-height: 1.35;
}

/* ============================================================
   MAIN CONTENT
   ============================================================ */

.main {
  padding: 0;
  max-width: 100%;
  overflow-x: hidden;
}

.top-bar {
  padding: 16px 40px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--navy);
  position: sticky;
  top: 0;
  z-index: 20;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold-dim);
}

.breadcrumb .sep { color: var(--border-strong); }
.breadcrumb .current { color: var(--gold); }

.top-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.top-btn {
  padding: 6px 12px;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--gold);
  font-family: 'DM Mono', monospace;
  transition: all 0.2s;
}
.top-btn:hover { background: rgba(201,168,76,0.08); border-color: var(--border-strong); }

/* ============================================================
   MÓDULO — CONTEÚDO PRINCIPAL
   ============================================================ */

.module-view {
  max-width: 920px;
  margin: 0 auto;
  padding: 40px 40px 80px;
}

.module-header {
  margin-bottom: 40px;
  padding-bottom: 28px;
  border-bottom: 1px solid var(--border);
}

.module-eyebrow {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.25em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.module-eyebrow .divider {
  width: 24px; height: 1px;
  background: var(--gold);
}

.module-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.8em, 4vw, 2.6em);
  font-weight: 700;
  color: var(--white);
  line-height: 1.15;
  margin-bottom: 14px;
}

.module-summary {
  font-size: 1.05em;
  color: var(--gray-300);
  line-height: 1.7;
  font-weight: 300;
  max-width: 700px;
}

/* ============================================================
   AVATAR SECTION
   ============================================================ */

.avatar-section {
  margin-bottom: 40px;
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.avatar-header {
  padding: 14px 20px;
  background: var(--navy-mid);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 10px;
}

.avatar-badge {
  width: 28px; height: 28px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold), var(--gold-light));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--navy);
  font-weight: 700;
  flex-shrink: 0;
}

.avatar-label {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold);
}

.avatar-video {
  position: relative;
  padding-bottom: 56.25%;
  background: var(--navy);
  overflow: hidden;
}

.avatar-video iframe {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  border: none;
}

.avatar-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--gold-dim);
  background:
    radial-gradient(ellipse at center, rgba(201,168,76,0.05) 0%, transparent 70%),
    var(--navy);
}

.avatar-placeholder-icon {
  font-size: 32px;
  opacity: 0.4;
}

.avatar-placeholder-text {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold-dim);
  text-align: center;
}
.avatar-placeholder-text strong {
  color: var(--gold);
  font-weight: 500;
  display: block;
  margin-bottom: 4px;
  font-size: 13px;
}

/* ============================================================
   CONTEÚDO DA AULA
   ============================================================ */

.content-section {
  margin-bottom: 44px;
}

.section-label {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.section-label::before {
  content: '';
  width: 20px; height: 1px;
  background: var(--gold);
}

.aula-content h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.35em;
  color: var(--white);
  margin: 28px 0 14px;
  font-weight: 700;
}

.aula-content p {
  color: var(--gray-100);
  margin-bottom: 14px;
  line-height: 1.75;
  font-weight: 300;
  font-size: 1em;
}

.aula-content ul {
  margin: 14px 0 20px;
  padding-left: 0;
}

.aula-content ul li {
  position: relative;
  padding-left: 22px;
  margin-bottom: 10px;
  color: var(--gray-100);
  line-height: 1.7;
  font-weight: 300;
}

.aula-content ul li::before {
  content: '─';
  position: absolute;
  left: 0;
  color: var(--gold);
  font-family: 'DM Mono', monospace;
}

.aula-content strong {
  color: var(--gold-light);
  font-weight: 500;
}

.aula-content em {
  color: var(--gold-pale);
  font-style: italic;
}

/* Callout / destaque */
.callout {
  background: var(--navy-card);
  border-left: 2px solid var(--gold);
  padding: 18px 22px;
  border-radius: 0 var(--radius) var(--radius) 0;
  margin: 24px 0;
}

.callout-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 8px;
}

.callout p { margin: 0; color: var(--gray-100); }

/* ============================================================
   ÁREA DE PRÁTICA — PROMPT BUILDER
   ============================================================ */

.practice-section {
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px 28px 24px;
  margin-bottom: 32px;
}

.practice-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 20px;
  flex-wrap: wrap;
}

.practice-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.3em;
  color: var(--white);
  font-weight: 700;
}

.practice-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 6px;
}

/* Seletor de nível 1/2/3 */
.level-selector {
  display: inline-flex;
  gap: 0;
  background: var(--navy);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 3px;
}

.level-btn {
  padding: 7px 14px;
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold-dim);
  border-radius: 4px;
  transition: all 0.2s;
}

.level-btn:hover { color: var(--gold); }

.level-btn.active {
  background: var(--gold);
  color: var(--navy);
  font-weight: 600;
}

/* Explicação do nível */
.level-hint {
  font-size: 13px;
  color: var(--gray-300);
  font-style: italic;
  margin-bottom: 18px;
  padding: 10px 14px;
  background: rgba(201,168,76,0.05);
  border-left: 2px solid var(--gold-dim);
  border-radius: 0 var(--radius) var(--radius) 0;
}

/* Caixa de prompt */
.prompt-box {
  position: relative;
  background: var(--navy);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px 24px;
  margin-bottom: 16px;
}

.prompt-text {
  font-family: 'DM Mono', monospace;
  font-size: 13px;
  color: var(--gray-100);
  line-height: 1.8;
  white-space: pre-wrap;
  word-wrap: break-word;
  max-height: 450px;
  overflow-y: auto;
  padding-right: 8px;
}

.prompt-text::-webkit-scrollbar { width: 5px; }
.prompt-text::-webkit-scrollbar-thumb { background: rgba(201,168,76,0.25); border-radius: 3px; }

/* Anatomia AIMED visível */
.prompt-text .ai-a { color: var(--teal); font-weight: 500; }
.prompt-text .ai-i { color: var(--gold-light); font-weight: 500; }
.prompt-text .ai-m { color: var(--purple); font-weight: 500; }
.prompt-text .ai-e { color: var(--green); font-weight: 500; }
.prompt-text .ai-d { color: var(--coral); font-weight: 500; }

/* Botões de ação do prompt */
.prompt-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 6px;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 14px;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-family: 'DM Sans', sans-serif;
  font-size: 12px;
  font-weight: 500;
  color: var(--gold);
  transition: all 0.2s;
}

.action-btn:hover {
  background: rgba(201,168,76,0.08);
  border-color: var(--border-strong);
  color: var(--gold-light);
}

.action-btn.primary {
  background: var(--gold);
  color: var(--navy);
  border-color: var(--gold);
  font-weight: 600;
}

.action-btn.primary:hover {
  background: var(--gold-light);
  border-color: var(--gold-light);
  color: var(--navy);
}

.action-btn .icon {
  font-size: 14px;
  line-height: 1;
}

.action-btn.copied {
  background: var(--green-dark);
  border-color: var(--green);
  color: var(--green);
}

/* Legenda da anatomia AIMED */
.aimed-legend {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  padding: 12px 16px;
  background: rgba(5,14,31,0.6);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 14px;
  font-size: 11px;
  font-family: 'DM Mono', monospace;
  letter-spacing: 0.05em;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--gray-300);
}

.legend-item .dot {
  width: 8px; height: 8px;
  border-radius: 50%;
}

.ld-a { background: var(--teal); }
.ld-i { background: var(--gold-light); }
.ld-m { background: var(--purple); }
.ld-e { background: var(--green); }
.ld-d { background: var(--coral); }

/* ============================================================
   NAVEGAÇÃO ENTRE MÓDULOS
   ============================================================ */

.module-nav {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding-top: 32px;
  border-top: 1px solid var(--border);
  margin-top: 40px;
}

.nav-btn {
  flex: 1;
  max-width: 48%;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 16px 20px;
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: all 0.2s;
  text-align: left;
}

.nav-btn:hover {
  background: var(--navy-card-hi);
  border-color: var(--border-strong);
}

.nav-btn.next {
  align-items: flex-end;
  text-align: right;
}

.nav-btn .nav-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--gold-dim);
  text-transform: uppercase;
}

.nav-btn .nav-title {
  font-size: 14px;
  color: var(--gray-100);
  font-weight: 500;
  line-height: 1.3;
}

.nav-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  pointer-events: none;
}

/* ============================================================
   PLACEHOLDER (MÓDULO VAZIO)
   ============================================================ */

.placeholder {
  padding: 40px;
  background: var(--navy-card);
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius-lg);
  text-align: center;
  color: var(--gray-300);
}

.placeholder-icon {
  font-size: 32px;
  color: var(--gold-dim);
  margin-bottom: 12px;
  opacity: 0.5;
}

.placeholder-text {
  font-family: 'DM Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold-dim);
}

/* ============================================================
   LAYOUTS ESPECIAIS DOS MÓDULOS
   ============================================================ */

.quote-hero {
  padding: 56px 40px;
  margin: 28px 0 40px;
  background:
    radial-gradient(ellipse at center, rgba(201,168,76,0.08) 0%, transparent 70%),
    var(--navy-card);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.quote-hero::before, .quote-hero::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}
.quote-hero::before { top: 0; }
.quote-hero::after { bottom: 0; }

.quote-mark {
  font-family: 'Playfair Display', serif;
  font-size: 72px;
  color: var(--gold);
  opacity: 0.3;
  line-height: 0.5;
  margin-bottom: 10px;
  font-style: italic;
}
.quote-text {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.3em, 2.6vw, 1.8em);
  font-weight: 400;
  font-style: italic;
  color: var(--white);
  line-height: 1.4;
  max-width: 700px;
  margin: 0 auto;
}
.quote-text strong {
  color: var(--gold);
  font-style: normal;
  font-weight: 700;
}

.promise-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 32px 0;
}
.promise-card {
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px 20px;
  transition: all 0.2s;
}
.promise-card:hover {
  border-color: var(--border-strong);
  transform: translateY(-2px);
}
.promise-number {
  font-family: 'Playfair Display', serif;
  font-size: 2.2em;
  font-weight: 900;
  color: var(--gold);
  opacity: 0.5;
  line-height: 1;
  margin-bottom: 10px;
}
.promise-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.1em;
  color: var(--white);
  font-weight: 700;
  margin-bottom: 8px;
}
.promise-text {
  font-size: 0.88em;
  color: var(--gray-300);
  line-height: 1.6;
  font-weight: 300;
}

.mini-map {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
