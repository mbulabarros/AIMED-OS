   ============================================================ */

function setLevel(lvl) {
  currentLevel = lvl;
  // re-render apenas da prática
  const modulo = findModule(currentModuleId);
  if (modulo && modulo.prompts) {
    const el = document.getElementById('practice');
    el.outerHTML = renderPractice(modulo.prompts);
  }
}

function findModule(id) {
  for (const b of PROGRAMA) {
    for (const m of b.modulos) {
      if (m.id === id) return m;
    }
  }
  return null;
}

/* ============================================================
   CLIPBOARD COM FALLBACK (funciona em file:// também)
   ============================================================ */

function copyToClipboard(text) {
  // Tenta API moderna primeiro (só funciona em HTTPS ou localhost)
  if (navigator.clipboard && window.isSecureContext) {
    return navigator.clipboard.writeText(text);
  }
  // Fallback para file:// e HTTP
  return new Promise((resolve, reject) => {
    const textArea = document.createElement('textarea');
    textArea.value = text;
    textArea.style.position = 'fixed';
    textArea.style.left = '-9999px';
    textArea.style.top = '0';
    textArea.setAttribute('readonly', '');
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    try {
      const ok = document.execCommand('copy');
      document.body.removeChild(textArea);
      if (ok) resolve();
      else reject(new Error('execCommand falhou'));
    } catch (err) {
      document.body.removeChild(textArea);
      reject(err);
    }
  });
}

/* ============================================================
   COPIAR PROMPT
   ============================================================ */

function copyPrompt(btn) {
  const promptText = document.getElementById('promptText').innerText;
  copyToClipboard(promptText).then(() => {
    btn.classList.add('copied');
    btn.innerHTML = '<span class="icon">✓</span> Copiado!';
    showToast('Prompt copiado para a área de transferência');
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.innerHTML = '<span class="icon">⎘</span> Copiar prompt';
    }, 2000);
  }).catch(err => {
    console.error('Erro ao copiar:', err);
    showToast('Erro ao copiar — selecione o texto manualmente');
  });
}

/* ============================================================
   ABRIR IA EM NOVA ABA
   ============================================================ */

function openAI(platform) {
  const promptText = document.getElementById('promptText').innerText;

  switch(platform) {
    case 'chatgpt':
      // ChatGPT aceita ?q= na URL — prompt já aparece digitado
      const chatgptUrl = 'https://chatgpt.com/?q=' + encodeURIComponent(promptText);
      window.open(chatgptUrl, '_blank');
      showToast('✓ ChatGPT aberto com o prompt já digitado — só dar Enter');
      break;

    case 'claude':
      // Claude não aceita prompt via URL — copia e abre
      copyToClipboard(promptText).catch(e => console.error(e));
      window.open('https://claude.ai/new', '_blank');
      showToast('✓ Prompt copiado — no Claude, cole com Ctrl+V (Cmd+V no Mac)');
      break;

    case 'gemini':
      // Gemini não aceita prompt via URL — copia e abre
      copyToClipboard(promptText).catch(e => console.error(e));
      window.open('https://gemini.google.com/app', '_blank');
      showToast('✓ Prompt copiado — no Gemini, cole com Ctrl+V (Cmd+V no Mac)');
      break;
  }
}

/* ============================================================
   TOAST
   ============================================================ */

function showToast(msg) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 4000);
}

