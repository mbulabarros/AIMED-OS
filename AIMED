   ============================================================ */

let currentModuleId = null;
let currentLevel = 2; // padrão: nível intermediário

/* ============================================================
   RENDER — TRILHA LATERAL
   ============================================================ */

function renderTrail() {
  const trail = document.getElementById('trail');
  trail.innerHTML = PROGRAMA.map(bloco => `
    <div class="block-group block-${bloco.numero}">
      <div class="block-header">
        <div class="block-dot"></div>
        <div class="block-label">Bloco ${String(bloco.numero).padStart(2,'0')} · Dia ${bloco.dia}</div>
        <div class="block-role">${bloco.role}</div>
      </div>
      <div class="block-modules">
        ${bloco.modulos.map(m => `
          <a class="module-link ${m.break ? 'break' : ''}"
             data-id="${m.id}"
             onclick="${m.break ? '' : `selectModule('${m.id}')`}">
            <span class="m-time">${m.horario}</span>
            <span class="m-title">${m.titulo}</span>
          </a>
        `).join('')}
      </div>
    </div>
  `).join('');
}

/* ============================================================
   SELECIONAR MÓDULO
   ============================================================ */

function selectModule(id) {
  currentModuleId = id;

  // atualizar sidebar
  document.querySelectorAll('.module-link').forEach(a => {
    a.classList.remove('active');
    if (a.dataset.id === id) a.classList.add('active');
  });

  // encontrar módulo
  let modulo = null, bloco = null;
  for (const b of PROGRAMA) {
    for (const m of b.modulos) {
      if (m.id === id) { modulo = m; bloco = b; break; }
    }
    if (modulo) break;
  }

  if (!modulo) return;

  renderModule(modulo, bloco);
  document.getElementById('crumb-module').textContent = modulo.titulo;

  // fechar sidebar no mobile
  document.getElementById('sidebar').classList.remove('open');

  // salvar no hash
  window.location.hash = id;

  // scroll top do conteúdo
  document.querySelector('.main').scrollTop = 0;
  window.scrollTo({top: 0, behavior: 'smooth'});
}

/* ============================================================
   RENDER — MÓDULO INDIVIDUAL
   ============================================================ */

function renderModule(modulo, bloco) {
  const view = document.getElementById('moduleView');

  // Encontrar módulo anterior/próximo
  const flatModules = PROGRAMA.flatMap(b => b.modulos).filter(m => !m.break);
  const idx = flatModules.findIndex(m => m.id === modulo.id);
  const prev = idx > 0 ? flatModules[idx - 1] : null;
  const next = idx < flatModules.length - 1 ? flatModules[idx + 1] : null;

  let html = `
    <header class="module-header">
      <div class="module-eyebrow">
        <span class="divider"></span>
        <span>Bloco ${String(bloco.numero).padStart(2,'0')} · ${bloco.role}</span>
        <span>·</span>
        <span>${modulo.horario}</span>
      </div>
      <h1 class="module-title">${modulo.titulo}</h1>
      <p class="module-summary">${modulo.summary}</p>
    </header>
  `;

  // Avatar
  html += renderAvatar(modulo);

  // Conteúdo da aula
  if (modulo.conteudo) {
    html += `
      <section class="content-section">
        <div class="section-label">Conteúdo da aula</div>
        <div class="aula-content">${modulo.conteudo}</div>
      </section>
    `;
  } else {
    html += `
      <section class="content-section">
        <div class="section-label">Conteúdo da aula</div>
        <div class="placeholder">
          <div class="placeholder-icon">◈</div>
          <div class="placeholder-text">Conteúdo a ser preenchido</div>
        </div>
      </section>
    `;
  }

  // Prática — prompts em 3 níveis
  if (modulo.prompts) {
    html += renderPractice(modulo.prompts);
  }

  // Navegação
  html += `
    <nav class="module-nav">
      ${prev ? `
        <button class="nav-btn prev" onclick="selectModule('${prev.id}')">
          <span class="nav-label">← Anterior</span>
          <span class="nav-title">${prev.titulo}</span>
        </button>
      ` : `<button class="nav-btn prev" disabled><span class="nav-label">Início</span><span class="nav-title">—</span></button>`}
      ${next ? `
        <button class="nav-btn next" onclick="selectModule('${next.id}')">
          <span class="nav-label">Próximo →</span>
          <span class="nav-title">${next.titulo}</span>
        </button>
      ` : `<button class="nav-btn next" disabled><span class="nav-label">Fim</span><span class="nav-title">—</span></button>`}
    </nav>
  `;

  view.innerHTML = html;
}

